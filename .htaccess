<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to /public in the URL bar
    RewriteCond %{THE_REQUEST} \s/+public/ [NC]
    RewriteRule ^public/(.*)$ /$1 [R=301,L]

    # Route everything into the public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Protect sensitive files
<FilesMatch "^(\.env|\.env\..*|composer\.(json|lock)|package(-lock)?\.json|artisan|\.gitignore|README\.md)$">
    Require all denied
</FilesMatch>

# Block framework directories
# NOTE: "storage" is intentionally NOT in this list. The public "storage" URL
# is Laravel's storage:link symlink (public/storage -> storage/app/public),
# which is meant to be publicly reachable and is what serves user avatars and
# any other files on the "public" disk. Blocking it here caused all avatar
# images (and anything else under the public disk) to return 403.
RedirectMatch 403 ^/(app|bootstrap|config|database|resources|routes|tests|vendor|node_modules)(/.*)?$

Options -Indexes
