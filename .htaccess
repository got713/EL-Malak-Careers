<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to /public in the URL bar
    RewriteCond %{THE_REQUEST} \s/+public/ [NC]
    RewriteRule ^public/(.*)$ /$1 [R=301,L]

    # Route everything into the public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Protect sensitive files
<FilesMatch "^(\.env|\.env\..*|composer\.(json|lock)|package(-lock)?\.json|artisan|\.gitignore|README\.md)$">
    Require all denied
</FilesMatch>

# Block framework directories
RedirectMatch 403 ^/(app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules)(/.*)?$

Options -Indexes
